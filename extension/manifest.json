{
  "manifest_version": 3,
  "name": "Tabmaggedon Bridge",
  "version": "0.1.0",
  "description": "Imports explicitly selected Chrome tabs into Tabmaggedon and closes them during Tab Rehab.",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://tabmageddon-hackcmu.onrender.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Tabmaggedon is ready"
  }
}
